{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3d-craft.local/schemas/run.v1.schema.json",
  "title": "3D-Craft run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "project_key", "created_at", "route", "capabilities", "versions", "stages", "repairs", "evidence", "unverified"],
  "properties": {
    "schema": {"const": "3d-craft.run.v1"},
    "run_id": {"type": "string", "minLength": 8},
    "project_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "route": {"type": "object"},
    "capabilities": {"type": "object", "additionalProperties": {"enum": ["available", "missing", "unverified"]}},
    "versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "stages": {"type": "array", "items": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"enum": ["pending", "running", "pass", "fail", "unverified", "blocked"]}}}},
    "repairs": {"type": "array", "maxItems": 3, "items": {"type": "object", "required": ["gate", "hypothesis", "change", "candidate_hash", "verdict"], "properties": {"gate": {"type": "string"}, "hypothesis": {"type": "string"}, "change": {"type": "string"}, "candidate_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "verdict": {"enum": ["improved", "regressed", "unchanged"]}}}},
    "evidence": {"type": "array", "items": {"type": "object"}},
    "unverified": {"type": "array", "items": {"type": "string"}}
  }
}
