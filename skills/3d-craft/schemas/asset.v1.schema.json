{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3d-craft.local/schemas/asset.v1.schema.json",
  "title": "3D-Craft asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "authority", "source", "derived", "tool_versions", "licenses", "gltf_summary"],
  "properties": {
    "schema": {"const": "3d-craft.asset.v1"},
    "authority": {"enum": ["procedural", "native", "hybrid"]},
    "source": {"$ref": "#/$defs/file"},
    "derived": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "tool_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "licenses": {"type": "array", "items": {"type": "object", "required": ["subject", "license"], "properties": {"subject": {"type": "string"}, "license": {"type": "string"}, "source": {"type": "string"}}}},
    "gltf_summary": {"type": "object", "required": ["nodes", "meshes", "primitives", "materials", "textures", "animations", "triangles", "extensions"], "properties": {"nodes": {"type": "integer", "minimum": 0}, "meshes": {"type": "integer", "minimum": 0}, "primitives": {"type": "integer", "minimum": 0}, "materials": {"type": "integer", "minimum": 0}, "textures": {"type": "integer", "minimum": 0}, "animations": {"type": "integer", "minimum": 0}, "triangles": {"type": "integer", "minimum": 0}, "extensions": {"type": "array", "items": {"type": "string"}}}}
  },
  "$defs": {"file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}}
}
